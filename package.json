{
  "name": "exp2",
  "version": "0.0.0",
  "description": "My Experiments",
  "author": "Pouya Larjani <pouya.larjani@gmail.com> (https://github.com/lepouya)",
  "main": "src/index.pug",
  "private": true,
  "repository": "github:lepouya/exp2",
  "scripts": {
    "start": "webpack serve",
    "debug": "webpack",
    "build": "webpack --mode=production",
    "test": "env TS_NODE_PROJECT=test/tsconfig.json mocha -r ts-node/register test/**/*.ts",
    "sprites": "npx ts-node scripts/make-sprites.ts",
    "update": "ncu --doctor -u && rm -rf node_modules && npm update",
    "release": "webpack --mode=production --env clean -o ../lepouya.github.io/exp2/"
  },
  "dependencies": {
    "break_eternity.js": "^1.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^6.4.1",
    "react-router-dom": "^6.4.1"
  },
  "devDependencies": {
    "@types/chai": "^4.3.3",
    "@types/mocha": "^9.1.1",
    "@types/node": "^18.7.19",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "chai": "^4.3.6",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.1",
    "mocha": "^10.0.0",
    "pug-plugin": "^4.3.2",
    "sass": "^1.55.0",
    "sass-loader": "^13.0.2",
    "ts-loader": "^9.4.1",
    "ts-node": "^10.9.1",
    "typescript": "^4.8.3",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.11.1"
  }
}